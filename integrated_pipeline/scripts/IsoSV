#!/usr/bin/env python3

"""
IsoSV Integrated Pipeline

This script serves as the main entry point for the integrated IsoSV pipeline.
It combines three major steps into a single, streamlined workflow:
1.  **Parsing**: Reads a BAM/CRAM file to identify structural variant (SV)
    candidates, such as large indels, soft clips, and split reads.
2.  **Clustering**: Groups the identified SV candidates based on genomic
    proximity and type to form consolidated SV clusters.
3.  **Annotation**: Annotates the SV clusters against a gene reference
    (from a pickled IntervalTree) to provide functional context, such as
    identifying gene fusions or exonic deletions, and outputs a VCF file.

The pipeline is designed to be run from the command line and accepts various
arguments to customize the behavior of each step.
"""

import argparse
import pysam
import csv
import logging

from dataclasses import asdict

from bam_parser import walk_cigar_indels_and_clips, parse_sa_tag
from clustering import cluster_indels, cluster_clips, cluster_splits
from annotator import annotate_candidate
from variant_objects import IndelObs, ClipObs, SplitObs
from trees import build_tx_trees
from utils import write_to_vcf

logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s - %(levelname)s - %(message)s'
)
logger = logging.getLogger(__name__)


def main():
    ap = argparse.ArgumentParser(description="Integrated pipeline for RNA-seq based SV detection, clustering, and annotation.")

    # Positional arguments
    positional = ap.add_argument_group("Positional arguments")
    positional.add_argument("in_bam", help="Input BAM/CRAM")

    # Required arguments
    required = ap.add_argument_group("Required arguments")
    required.add_argument("-o", "--out-prefix", required=True, help="Output prefix for TSVs")
    required.add_argument("--gtf", required=True, help="Path to plain GTF file for building gene annotation BED and cache")
    required.add_argument("--reference", help="Reference FASTA (required for CRAM)")

    # Optional arguments (general options)
    options = ap.add_argument_group("Options")
    options.add_argument("--min-mapq", type=int, default=20)
    options.add_argument("--min-ins", type=int, default=20, help="Minimum insertion length to report")
    options.add_argument("--min-del", type=int, default=20, help="Minimum deletion length to report")
    options.add_argument("--min-clip", type=int, default=25, help="Minimum soft/hard clip length to report")
    options.add_argument("--bp-window", type=int, default=10, help="Breakpoint clustering window (bp)")

    # Debugging / developer options
    debug = ap.add_argument_group("Debugging options")
    debug.add_argument("--save-parser-output", action="store_true", help="Save the raw, unclustered output of the parsing stage for debugging.")
    debug.add_argument("--max-readnames", type=int, default=3, help="Max example read names per cluster")

    args = ap.parse_args()

    # Step 0: Build trees
    tx_trees = build_tx_trees(args.gtf)

    # Step 1: Parsing
    samfile = pysam.AlignmentFile(args.in_bam, "rb")
    indel_obs, clip_obs, split_obs = [], [], []
    for aln in samfile.fetch(until_eof=True):
        if aln.is_unmapped or aln.is_secondary or aln.is_duplicate:
            continue
        if aln.mapping_quality < args.min_mapq:
            continue

        for obs in walk_cigar_indels_and_clips(aln, args.min_ins, args.min_del, args.min_clip):
            if isinstance(obs, IndelObs):
                indel_obs.append(obs)
            else:
                clip_obs.append(obs)
        
        sa = aln.get_tag("SA") if aln.has_tag("SA") else None
        if sa:
            try:
                sa_entries = parse_sa_tag(sa)
                primary_right = aln.reference_end
                for seg in sa_entries:
                    rname2, pos2 = seg["rname"], seg["pos"]
                    split_obs.append(SplitObs(
                        chrom1=aln.reference_name, pos1=primary_right,
                        chrom2=rname2, pos2=pos2,
                        mapq=aln.mapping_quality, rname=aln.query_name,
                        same_chrom=(aln.reference_name == rname2)
                    ))
            except Exception:
                print("[WARNING] Error parsing SA tag for read:", aln.query_name)
                pass # Ignore SA parsing errors
    samfile.close()

    if args.save_parser_output:
        print("[INFO] Saving raw parser output...")
        if indel_obs:
            with open(f"{args.out_prefix}.raw_indels.tsv", "w", newline="") as f:
                writer = csv.DictWriter(f, fieldnames=asdict(indel_obs[0]).keys(), delimiter='	')
                writer.writeheader()
                writer.writerows(asdict(obs) for obs in indel_obs)
        if clip_obs:
            with open(f"{args.out_prefix}.raw_clips.tsv", "w", newline="") as f:
                writer = csv.DictWriter(f, fieldnames=asdict(clip_obs[0]).keys(), delimiter='	')
                writer.writeheader()
                writer.writerows(asdict(obs) for obs in clip_obs)
        if split_obs:
            with open(f"{args.out_prefix}.raw_splits.tsv", "w", newline="") as f:
                writer = csv.DictWriter(f, fieldnames=asdict(split_obs[0]).keys(), delimiter='	')
                writer.writeheader()
                writer.writerows(asdict(obs) for obs in split_obs)

    # Step 2: Clustering candidate by candidate
    indel_clusters = cluster_indels(indel_obs, args.bp_window, trees=tx_trees, max_readnames=args.max_readnames)
    clip_clusters = cluster_clips(clip_obs, args.bp_window, trees=tx_trees, max_readnames=args.max_readnames)
    split_clusters = cluster_splits(split_obs, args.bp_window, trees=tx_trees, max_readnames=args.max_readnames)

    # Additional TSV Output?
    with open(f"{args.out_prefix}.indels.tsv", "w", newline="") as f:
        w = csv.writer(f, delimiter="	")
        w.writerow(["chrom","pos","end","svtype","length","support","median_mapq","example_reads","example_ins_seq","genes"])
        for c in sorted(indel_clusters, key=lambda x: (x["chrom"], x["pos"], x["svtype"])):
            end = c["pos"] + c["length"] - 1 if c["svtype"] == "DEL" else c["pos"]
            w.writerow([c["chrom"], c["pos"], end, c["svtype"], c["length"], c["support"], c["median_mapq"], c["example_reads"], c["example_ins_seq"], c["genes"]])

    with open(f"{args.out_prefix}.softclips.tsv", "w", newline="") as f:
        w = csv.writer(f, delimiter="	")
        w.writerow(["chrom","pos","side","support","median_mapq","median_cliplen","example_reads","genes"])
        for c in sorted(clip_clusters, key=lambda x: (x["chrom"], x["pos"], x["side"])):
            w.writerow([c["chrom"], c["pos"], c["side"], c["support"], c["median_mapq"], c["median_cliplen"], c["example_reads"], c["genes"]])

    with open(f"{args.out_prefix}.splits.tsv", "w", newline="") as f:
        w = csv.writer(f, delimiter="	")
        w.writerow(["chrom1","pos1","chrom2","pos2","support","median_mapq","notes","example_reads","genes_left","genes_right"])
        for c in sorted(split_clusters, key=lambda x: (x["chrom1"], x["pos1"], x["chrom2"], x["pos2"])):
            w.writerow([c["chrom1"], c["pos1"], c["chrom2"], c["pos2"], c["support"], c["median_mapq"], c["notes"], c["example_reads"], c["genes_left"], c["genes_right"]])
            
    # Step 3: Annotation and VCF output
    annotated_candidates = []
    for indel in indel_clusters:
        indel["length"] = int(indel["length"])
        indel["support"] = int(indel["support"])
        indel["end"] = indel["pos"] + indel["length"] - 1 if indel["svtype"] == "DEL" else indel["pos"]
        annotated_candidate = annotate_candidate(indel, tx_trees)

        if annotated_candidate is None:
            raise ValueError("Annotation failed for candidate:", indel, "Something is wrong with the gene annotation tree.")
        annotated_candidates.append(annotated_candidate)

    write_to_vcf(annotated_candidates, f"{args.out_prefix}.annotated.vcf")
    logger.info(f"Annotated VCF written to {args.out_prefix}.annotated.vcf")

    logger.info(f"Found {len(indel_clusters)} indel clusters.")
    logger.info(f"Found {len(clip_clusters)} clip clusters.")
    logger.info(f"Found {len(split_clusters)} split clusters.")
    logger.info("Pipeline finished.")

if __name__ == "__main__":
    main()
